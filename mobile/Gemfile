source 'https://rubygems.org'

# Standard React Native Gemfile (RN 0.75 baseline) with extra pins to keep
# CocoaPods working on Ruby 4.0, where activesupport ≥ 7.1 needs gems that
# were split out of the stdlib (base64, drb, etc.).
ruby ">= 2.6.10"

gem 'cocoapods', '>= 1.13', '< 1.15'
gem 'activesupport', '>= 6.1.7.5', '< 7.1.0'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'
# kconv lives here on Ruby 3.4+ where it was split out of the stdlib.
gem 'nkf'
