<?xml version="1.0" encoding="utf-8"?>
<!--
    Native launch screen drawn the instant the user taps the app icon, before
    the React Native runtime has started. The colored background here is the
    same as the JS SplashScreen so the handoff is seamless. The launcher
    icon is centered, since it's the only branded asset we have at native
    size without a separate logo image set.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_background" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <bitmap android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
